NODE_ENV=development
PORT=3000
API_PREFIX=/api
ALLOWED_ORIGINS=replace-with-your-allowed-origins
FRONTEND_URL=replace-with-your-frontend-url

JWT_ACCESS_SECRET=replace-with-a-secure-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-secure-random-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_VERIFICATION_SECRET=replace-with-a-secure-random-secret
JWT_VERIFICATION_EXPIRES_IN=24h


MAIL_HOST=replace-with-your-mail-host
MAIL_PORT=replace-with-your-mail-port
MAIL_SECURE=replace-with-your-mail-secure-setting
MAIL_USER=replace-with-your-mail-user
MAIL_PASSWORD=replace-with-your-mail-password
MAIL_FROM=replace-with-your-mail-from
MAIL_API_KEY=replace-with-your-resend-api-key

DATABASE_URL=replace-with-your-database-url
DIRECT_URL=replace-with-your-direct-database-url

THROTTLE_TTL=60_000
THROTTLE_LIMIT=60
THROTTLE_AUTH_LIMIT=5
VERIFICATION_COOLDOWN_MS=60_000
VERIFICATION_MAX_PER_DAY=5

OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ISSUES_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
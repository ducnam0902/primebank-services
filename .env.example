NODE_ENV=development
PORT=3000
API_PREFIX=/api
ALLOWED_ORIGINS=replace-with-your-allowed-origins

JWT_ACCESS_SECRET=replace-with-a-secure-random-secret
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

MAIL_FROM=replace-with-your-mail-from
MAIL_API_KEY=replace-with-your-resend-api-key
#Testing env show as log, not send to mail
#Production need to change to resend to send an email to verify user
MAIL_DRIVER=log

DATABASE_URL=replace-with-your-database-url
DIRECT_URL=replace-with-your-direct-database-url


OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ISSUES_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
OTP_HMAC_SECRET=replace-with-a-secure-random-secret-at-least-32-chars
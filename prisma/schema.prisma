// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  LOCKED
}

enum Role {
  CUSTOMER
  ADMIN
}

enum TokenType {
  EMAIL_VERIFICATION
  REFRESH
  PASSWORD_RESET
}

enum AccountType {
  PAYMENT
  SAVINGS
}

enum AccountStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LedgerEntryType {
  TRANSFER_OUT
  TRANSFER_IN
  DEPOSIT
}

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  email               String     @unique @db.VarChar(255)
  passwordHash        String     @map("password_hash") @db.VarChar(255)
  status              UserStatus @default(PENDING_VERIFICATION)
  role                Role       @default(CUSTOMER)
  failedLoginAttempts Int        @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime?  @map("locked_until") @db.Timestamptz(3)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer?
  tokens   Token[]

  @@map("users")
}

model Customer {
  id          String   @id @default(uuid()) @db.Uuid
  cifNumber   String   @unique @map("cif_number") @db.VarChar(20)
  fullName    String   @map("full_name") @db.VarChar(120)
  dateOfBirth DateTime @map("date_of_birth") @db.Date
  phoneNumber String   @unique @map("phone_number") @db.VarChar(20)
  nationalId  String   @unique @map("national_id") @db.VarChar(12)
  address     String   @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  userId String @unique @map("user_id") @db.Uuid

  user     User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  accounts Account[]

  @@map("customers")
}

model Token {
  id        String    @id @default(uuid()) @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  userId String @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("tokens")
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  accountNumber String        @unique @map("account_number") @db.VarChar(20)
  type          AccountType
  currency      String        @default("VND") @db.VarChar(3)
  status        AccountStatus @default(ACTIVE)
  balance       Decimal       @default(0) @db.Decimal(19, 2)
  version       Int           @default(0)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  customerId String @map("customer_id") @db.Uuid

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  outgoingTransfers Transfer[]    @relation("OutgoingTransfers")
  incomingTransfers Transfer[]    @relation("IncomingTransfers")
  ledgerEntries     LedgerEntry[]

  @@index([customerId])
  @@map("accounts")
}

model Transfer {
  id              String         @id @default(uuid()) @db.Uuid
  referenceNumber String         @unique @map("reference_number") @db.VarChar(20)
  fromAccountId   String         @map("from_account_id") @db.Uuid
  toAccountId     String         @map("to_account_id") @db.Uuid
  amount          Decimal        @db.Decimal(19, 2)
  description     String?        @db.VarChar(255)
  status          TransferStatus @default(PENDING)
  idempotencyKey  String         @unique @map("idempotency_key") @db.VarChar(64)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  fromAccount   Account       @relation("OutgoingTransfers", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccount     Account       @relation("IncomingTransfers", fields: [toAccountId], references: [id], onDelete: Restrict)
  ledgerEntries LedgerEntry[]

  @@index([fromAccountId])
  @@index([toAccountId])
  @@map("transfers")
}

model LedgerEntry {
  id           String          @id @default(uuid()) @db.Uuid
  accountId    String          @map("account_id") @db.Uuid
  transferId   String?         @map("transfer_id") @db.Uuid
  type         LedgerEntryType
  amount       Decimal         @db.Decimal(19, 2)
  balanceAfter Decimal         @map("balance_after") @db.Decimal(19, 2)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  account      Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transfer     Transfer?       @relation(fields: [transferId], references: [id], onDelete: Restrict)

  @@index([accountId, createdAt])
  @@index([transferId])
  @@map("ledger_entries")
}
